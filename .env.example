# Copy to .env.local for local development, or set these in Vercel for production.
# `npm run dev` fills in CALLBOOK_PASSWORD and AUTH_SECRET in .env.local if they're missing.

# The shared password for Denise's Callbook pages. /request stays public.
CALLBOOK_PASSWORD=

# Signs the session cookie. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
AUTH_SECRET=

# Local: leave unset to use data/callbook.db.
# Production (required on Vercel): your Turso database URL and token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
